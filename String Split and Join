
def split_and_join(line):
    # Split the string on a " " (space) delimiter
    split_list = line.split(" ")
    
    # Join the list using a "-" (hyphen)
    result = "-".join(split_list)
    
    return result

if __name__ == '__main__':
    line = input()
    result = split_and_join(line)
    print(result)
