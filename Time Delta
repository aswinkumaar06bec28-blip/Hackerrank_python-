import sys
from datetime import datetime

def time_delta(t1, t2):
    # This format perfectly matches the input string structure
    time_format = '%a %d %b %Y %H:%M:%S %z'
    
    # Parse both strings into datetime objects
    time1 = datetime.strptime(t1, time_format)
    time2 = datetime.strptime(t2, time_format)
    
    # Subtract them to get a timedelta object, get total seconds, and take the absolute value
    diff_in_seconds = abs((time1 - time2).total_seconds())
    
    # Return as an integer converted to a string
    return str(int(diff_in_seconds))

if __name__ == '__main__':
    # Read the number of test cases
    t = int(input())
    
    for _ in range(t):
        t1 = input()
        t2 = input()
        
        # Calculate and print the difference
        delta = time_delta(t1, t2)
        print(delta)
