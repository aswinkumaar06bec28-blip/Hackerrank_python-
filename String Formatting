def print_formatted(number):
    # Determine the width of the binary representation of the maximum number
    # bin(number) returns '0b...' so we slice [2:] to get just the binary digits
    width = len(bin(number)[2:])
    
    # Loop from 1 to the given number (inclusive)
    for i in range(1, number + 1):
        # Format and print the numbers
        # {i:{width}d} means format 'i' as an integer (d) with a minimum width
        # The space defaults to right-alignment
        print(f"{i:{width}d} {i:{width}o} {i:{width}X} {i:{width}b}")

if __name__ == '__main__':
    n = int(input())
    print_formatted(n)
