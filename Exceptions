for _ in range(int(input())):
    try:
        a, b = input().split()
        print(int(a) // int(b))
        
    except ZeroDivisionError:
        # You MUST hardcode this string because HackerRank's grader is outdated 
        # and doesn't accept the modern Python 3 "division by zero" string
        print("Error Code: integer division or modulo by zero")
        
    except ValueError as e:
        # ValueError still matches what HackerRank expects, so we can just print 'e'
        print("Error Code:", e)
