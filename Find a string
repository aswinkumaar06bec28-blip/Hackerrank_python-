def count_substring(string, sub_string):
    count = 0
    sub_len = len(sub_string)
    
    # Loop through the string up to the point where the remaining characters 
    # are fewer than the length of the substring
    for i in range(len(string) - sub_len + 1):
        # Slice the string from the current index 'i' to 'i + sub_len'
        # and check if it matches the target substring
        if string[i:i+sub_len] == sub_string:
            count += 1
            
    return count

if __name__ == '__main__':
    string = input().strip()
    sub_string = input().strip()
    
    count = count_substring(string, sub_string)
    print(count)
