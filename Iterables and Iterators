from itertools import combinations

if __name__ == '__main__':
    # Read inputs
    n = int(input())
    letters = input().split()
    k = int(input())
    
    # 1. Generate all possible index combinations of length K
    # We use range(n) to get indices, ensuring we handle duplicate letters correctly
    total_combinations = list(combinations(range(n), k))
    
    # 2. Find indices where the letter is 'a'
    a_indices = [i for i, char in enumerate(letters) if char == 'a']
    
    # 3. Count how many combinations contain at least one of those indices
    count = 0
    for combo in total_combinations:
        # Check if any index in the current combination is an 'a' index
        if any(index in a_indices for index in combo):
            count += 1
            
    # 4. Calculate and print the probability
    print(f"{count / len(total_combinations):.4f}")
