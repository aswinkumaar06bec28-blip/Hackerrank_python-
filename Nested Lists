if __name__ == '__main__':
    students = []
    for _ in range(int(input())):
        name = input()
        score = float(input())
        students.append([name, score])

    # 1. Get all unique scores and sort them ascending
    # We use a set to ensure we don't have duplicates of the same score
    scores = sorted(list(set([x[1] for x in students])))
    
    # 2. Identify the second lowest score
    second_lowest_score = scores[1]
    
    # 3. Use list comprehension to find names with that score
    # Then sort the names alphabetically
    result_names = sorted([x[0] for x in students if x[1] == second_lowest_score])
    
    # 4. Print each name on a new line
    for name in result_names:
        print(name)
