import re

rows, cols = map(int, input().split())
matrix = [input() for _ in range(rows)]

# Read column by column (top to bottom, left to right)
decoded = ''.join(matrix[r][c] for c in range(cols) for r in range(rows))

# Replace symbols/spaces between two alphanumeric characters with a single space
print(re.sub(r'(?<=[A-Za-z0-9])[^A-Za-z0-9]+(?=[A-Za-z0-9])', ' ', decoded))
